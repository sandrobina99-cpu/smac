# Gateway server listening config
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data

# Optional 32+ char hex/random secret for AES-256-GCM encryption & session signing.
# If left blank, a persistent secret is generated at ${DATA_DIR}/.master.key
MASTER_SECRET=

# Initial administrator account (seeded on first startup if admins table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Upstream OpenAI-compatible / Codex provider
UPSTREAM_BASE_URL=https://api.sandrobina.me/v1
UPSTREAM_API_KEY=

# Public base URL shown in Client desktop app for API consumers
PUBLIC_BASE_URL=http://localhost:8787/v1

# Default 7-day rolling weighted token limit for newly created users
DEFAULT_WEEKLY_TOKEN_LIMIT=1000000
