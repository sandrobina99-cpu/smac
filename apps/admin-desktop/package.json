{
  "name": "@sandrobina/admin-desktop",
  "version": "1.2.1",
  "private": true,
  "author": "sandrobina99-cpu",
  "description": "smac 管理端 — 主机设备与 API 分发统一管理控制台",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && node scripts/rename-cjs.mjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"wait-on tcp:5173 && npm:dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/rename-cjs.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:mac:dir": "npm run build && electron-builder --mac --dir",
    "pack:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@sandrobina/shared": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "me.sandrobina.api-admin",
    "productName": "smac 管理端",
    "electronVersion": "35.7.5",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "!node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "sandrobina-admin-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "icon": "build/icon.png",
    "nsis": {
      "artifactName": "sandrobina-admin-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "sandrobina-admin-${version}-win-portable.${ext}"
    }
  }
}
