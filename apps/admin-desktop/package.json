{
  "name": "@sandrobina/admin-desktop",
  "version": "2.0.1",
  "private": true,
  "author": "sandrobina99-cpu",
  "description": "smac 管理端 — 文件中枢、全局网络拓扑、远程 Agent 与 API 分发一体化控制台",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && node scripts/rename-cjs.mjs && electron .",
    "dev": "npm run dev:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/rename-cjs.mjs",
    "build:runtime": "node scripts/stage-runtime.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "pack:mac": "npm run build && npm run build:runtime && electron-builder --mac",
    "pack:mac:dir": "npm run build && npm run build:runtime && electron-builder --mac --dir",
    "pack:win": "npm run build && npm run build:runtime && electron-builder --win"
  },
  "dependencies": {
    "@sandrobina/shared": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "me.sandrobina.api-admin",
    "productName": "smac 管理端",
    "electronVersion": "35.7.5",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "!node_modules/**/*",
      "!runtime/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "smac-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "smac 管理端需要访问本地网络以直连局域网与 ZeroTier 设备，实现文件同步、拖拽传桌面、SSH 终端与剪贴板同步。"
      },
      "artifactName": "sandrobina-admin-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "smac 管理端",
      "artifactName": "sandrobina-admin-${version}-win-setup.${ext}"
    }
  }
}
